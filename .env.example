# Flask Secret Key for session signing
SECRET_KEY=change-this-to-a-secure-random-secret-key

# Database Connection URL (SQLite default: taskflow.db in project root)
DATABASE_URL=sqlite:///taskflow.db

# Optional Google OAuth 2.0 Client ID for Google Sign-In
GOOGLE_CLIENT_ID=

# Set to True in production with HTTPS enabled
SESSION_COOKIE_SECURE=False

# Flask Development Settings
FLASK_DEBUG=True
FLASK_RUN_PORT=5000
